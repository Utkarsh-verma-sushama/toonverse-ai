  "GATEWAY_ADAPTER_PROTOCOL": "bounded-metered-v1",
  "GATEWAY_PROVIDER": "",
  "GATEWAY_MODEL": "",
  "GATEWAY_TIMEOUT_MS": "30000",
  "GATEWAY_RECOVERY_ENABLED": "false",
  "GATEWAY_RECOVERY_CONFIRMATION": ""
 },
 "d1_databases": [
  {"binding":"DB","database_name":"uvenaro-chat-staging","database_id":"SET_ISOLATED_CHAT_STAGING_D1_ID"},
  {"binding":"GATEWAY_DB","database_name":"uvenaro-gateway-receipts-staging","database_id":"SET_ISOLATED_GATEWAY_STAGING_D1_ID"}
 ],
 "services": [{"binding":"PROVIDER_ADAPTER","service":"uvenaro-bounded-provider-adapter-staging"}],
 "observability": {"enabled": false}
}
