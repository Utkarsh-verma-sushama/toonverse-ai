rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function owns(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function validProfile(data) {
      return data.keys().hasAll(['createdAt', 'updatedAt'])
        && data.keys().hasOnly(['displayName', 'photoURL', 'locale', 'createdAt', 'updatedAt'])
        && data.get('displayName', '') is string
        && data.get('displayName', '').size() <= 120
        && data.get('photoURL', '') is string
        && data.get('photoURL', '').size() <= 2048
        && (data.get('photoURL', '') == '' || data.photoURL.matches('https://[^\\s]+'))
        && data.get('locale', 'en') is string
        && data.get('locale', 'en').matches('[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8}){0,3}')
        && data.createdAt is timestamp
        && data.updatedAt == request.time;
    }

    match /users/{uid} {
      allow get: if owns(uid);
      allow list: if false;
      allow create: if owns(uid) && validProfile(request.resource.data)
        && request.resource.data.createdAt == request.time;
      allow update: if owns(uid) && validProfile(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;
    }

    function validProject(data, uid) {
      return data.keys().hasAll(['ownerId', 'name', 'type', 'status', 'createdAt', 'updatedAt', 'schemaVersion'])
        && data.keys().hasOnly(['ownerId', 'name', 'type', 'status', 'thumbnailPath', 'createdAt', 'updatedAt', 'schemaVersion'])
        && data.ownerId == uid
        && data.name is string && data.name.size() > 0 && data.name.size() <= 200
        && data.type is string && data.type.size() > 0 && data.type.size() <= 40
        && data.status in ['draft', 'ready', 'archived']
        && data.schemaVersion is int && data.schemaVersion == 1
        && data.get('thumbnailPath', '') is string
        && data.get('thumbnailPath', '').size() <= 512
        && (data.get('thumbnailPath', '') == ''
          || (data.thumbnailPath.split('/').size() >= 3
            && data.thumbnailPath.split('/')[0] == 'users'
            && data.thumbnailPath.split('/')[1] == uid
            && !data.thumbnailPath.split('/').hasAny(['..', '.'])))
        && data.createdAt is timestamp && data.updatedAt == request.time;
    }

    match /users/{uid}/projects/{projectId} {
      allow read: if owns(uid);
      allow create: if owns(uid) && validProject(request.resource.data, uid)
        && request.resource.data.createdAt == request.time;
      allow update: if owns(uid) && validProject(request.resource.data, uid)
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if owns(uid);
    }

    // Claims/evidence/audit/billing/roles are backend-only. A client admin claim
    // adds no access. The backend must enforce ownership and log privileged use.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
