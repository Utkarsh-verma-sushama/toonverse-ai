rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function owns(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    function validTimestamp(field) {
      return field is timestamp;
    }

    // A user may read their profile and update only a constrained set of fields.
    match /users/{uid} {
      allow create: if owns(uid)
        && request.resource.data.keys().hasOnly([
          'displayName', 'photoURL', 'locale', 'createdAt', 'updatedAt'
        ])
        && validTimestamp(request.resource.data.createdAt)
        && validTimestamp(request.resource.data.updatedAt);

      allow read: if owns(uid) || isAdmin();

      allow update: if owns(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'photoURL', 'locale', 'updatedAt'
        ])
        && validTimestamp(request.resource.data.updatedAt);

      allow delete: if false;
    }

    // Private, per-user creative projects.
    match /users/{uid}/projects/{projectId} {
      allow read: if owns(uid);
      allow create, update: if owns(uid)
        && request.resource.data.ownerId == uid
        && request.resource.data.keys().hasOnly([
          'ownerId', 'name', 'type', 'status', 'thumbnailPath',
          'createdAt', 'updatedAt', 'schemaVersion'
        ])
        && validTimestamp(request.resource.data.createdAt)
        && validTimestamp(request.resource.data.updatedAt);
      allow delete: if owns(uid);
    }

    // Verification records and evidence are written only by trusted backend code.
    match /claims/{claimId} {
      allow read: if signedIn();
      allow write: if isAdmin();

      match /evidence/{evidenceId} {
        allow read: if signedIn();
        allow write: if isAdmin();
      }
    }

    match /auditLogs/{entryId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Deny every path that has not been explicitly authorized above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
