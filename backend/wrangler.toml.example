name = "uvenaro-core-api"
main = "worker.mjs"
compatibility_date = "2026-09-01"
workers_dev = true

[vars]
ENVIRONMENT = "production"
AUTH_REQUIRED = "true"
CHAT_EXECUTION_ENABLED = "false"
CHAT_PROVIDER = ""
CHAT_MODEL = ""
CHAT_PROVIDER_URL = ""
CHAT_MAX_INPUT_TOKENS = "4000"
CHAT_MAX_OUTPUT_TOKENS = "1000"
CHAT_TIMEOUT_MS = "30000"
CHAT_GLOBAL_DAILY_COST_MICROUSD = "0"
# CHAT_PROVIDER_API_KEY must be stored as an encrypted secret, never in this file.
ALLOWED_ORIGINS = "https://YOUR_DOMAIN"
MODEL_CATALOG_JSON = "[]"

[[d1_databases]]
binding = "DB"
database_name = "uvenaro-core"
database_id = "SET_D1_DATABASE_ID"

[[r2_buckets]]
binding = "MEDIA"
bucket_name = "uvenaro-media"

[[queues.producers]]
binding = "AGENT_QUEUE"
queue = "uvenaro-agent-runs"

[[queues.consumers]]
queue = "uvenaro-agent-runs"
max_batch_size = 5
max_batch_timeout = 5
max_retries = 3
dead_letter_queue = "uvenaro-agent-dead-letter"
