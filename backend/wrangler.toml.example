name = "uvenaro-core-api"
main = "worker.mjs"
compatibility_date = "2026-09-01"
workers_dev = true

[vars]
ENVIRONMENT = "production"
AUTH_REQUIRED = "true"
ACCOUNT_AUTH_ENABLED = "false"
ACCOUNT_TOTP_ENABLED = "false"
# ACCOUNT_SESSION_KEY: encrypted secret containing 32 random bytes, base64url.
# Retain the key for existing sessions; rotating it requires signing users out.
# Serve web and API on the same HTTPS site (e.g. uvenaro.com/api).
# Native WebViews need verified secure cookie transport before activation.
AGENT_EXECUTION_ENABLED = "false"
# Independent production spend confirmation. Keep empty while agents are disabled.
# Enabling AGENT_EXECUTION_ENABLED alone must never authorize metered provider spend.
AGENT_PAID_EXECUTION_CONFIRMATION = ""
# Privileged Agent reconciliation is independently safe-off. Never expose this
# value to clients; configure it only in an audited operator-only path.
AGENT_RECONCILIATION_CONFIRMATION = ""
# Provider dispatch remains independently safe-off until a metered gateway is configured.
AGENT_PROVIDER_DISPATCH_ENABLED = "false"
# Production dispatch must terminate at a separately audited, pinned metered gateway.
AGENT_PROVIDER_ALLOWED_ORIGIN = ""
AGENT_PROVIDER_APPROVED_ORIGIN = ""
AGENT_PROVIDER_GATEWAY_AUDITED = "false"
AGENT_PROVIDER_PROTOCOL = "metered-v1"
# AGENT_PROVIDER_API_KEY must be stored as an encrypted secret, never in this file.
# Agent execution stays fail-closed until these server-owned metering limits are
# reviewed for the production provider/model. Clients must never supply them.
AGENT_PROVIDER = ""
AGENT_MODEL = ""
AGENT_MAX_STEPS = "8"
AGENT_MAX_RUNTIME_MS = "60000"
AGENT_MAX_INPUT_TOKENS = "4000"
AGENT_MAX_OUTPUT_TOKENS = "1000"
# Required before AGENT_EXECUTION_ENABLED=true. Zero/missing is intentionally invalid.
AGENT_GLOBAL_DAILY_COST_MICROUSD = "0"
MODEL_ROUTING_ENABLED = "false"
CHAT_EXECUTION_ENABLED = "false"
# Independent production confirmation. Keep empty while paid chat is disabled.
# Enabling CHAT_EXECUTION_ENABLED alone must never authorize provider spend.
CHAT_PAID_EXECUTION_CONFIRMATION = ""
# Privileged internal reconciliation is independently safe-off in production.
# Never expose this value to clients; configure it only in an audited operator path.
CHAT_RECONCILIATION_CONFIRMATION = ""
# Explicit operator-only GET receipt lookup; never activates generation.
CHAT_RECEIPT_LOOKUP_ENABLED = "false"
CHAT_RECEIPT_BASE_URL = ""
CHAT_RECEIPT_TIMEOUT_MS = "10000"
# CHAT_RECEIPT_API_KEY: server secret with read-only receipt permissions.
CHAT_PROVIDER = ""
CHAT_MODEL = ""
CHAT_PROVIDER_URL = ""
CHAT_PROVIDER_ALLOWED_ORIGIN = ""
# Separately pinned canonical HTTPS gateway origin (no path, query, fragment, credentials or trailing slash).
# Keep empty while paid chat is disabled; never set this to a raw model-vendor origin.
CHAT_PROVIDER_APPROVED_ORIGIN = ""
# Explicit operator assertion required before production dispatch. Keep false until the
# metered gateway has actually completed the required audit; this is not proof by itself.
CHAT_PROVIDER_GATEWAY_AUDITED = "false"
# Requires an audited metered gateway; not a raw model API endpoint.
CHAT_PROVIDER_PROTOCOL = "metered-v1"
CHAT_MAX_INPUT_TOKENS = "4000"
CHAT_MAX_OUTPUT_TOKENS = "1000"
CHAT_TIMEOUT_MS = "30000"
CHAT_GLOBAL_DAILY_COST_MICROUSD = "0"
# CHAT_PROVIDER_API_KEY must be stored as an encrypted secret, never in this file.
ALLOWED_ORIGINS = "https://YOUR_DOMAIN"
FIREBASE_PROJECT_ID = "toonverse-ai"
# App Check uses the numeric Firebase project number, not the project ID.
FIREBASE_PROJECT_NUMBER = "594612167862"
# Keep false until valid app IDs are registered and staging tests pass. Production
# release gate requires true. Comma-separated Firebase App IDs only.
APP_CHECK_ENFORCEMENT_ENABLED = "false"
APP_CHECK_ALLOWED_APP_IDS = ""
# Enable only after migration 0004 is applied. Production release gate requires true.
REPLAY_PROTECTION_ENABLED = "false"
# Firebase Web API key restricted to Identity Toolkit, never a service-account key.
# Missing key fails closed; required for disabled/deleted/revoked-session checks.
FIREBASE_WEB_API_KEY = ""
MODEL_CATALOG_JSON = "[]"

[[d1_databases]]
binding = "DB"
database_name = "uvenaro-core"
database_id = "SET_D1_DATABASE_ID"
migrations_dir = "migrations"

[[r2_buckets]]
binding = "MEDIA"
bucket_name = "uvenaro-media"

[[queues.producers]]
binding = "AGENT_QUEUE"
queue = "uvenaro-agent-runs"

[[queues.consumers]]
queue = "uvenaro-agent-runs"
max_batch_size = 5
max_batch_timeout = 5
max_retries = 3
dead_letter_queue = "uvenaro-agent-dead-letter"

# Only never-dispatched expired holds are released by this sweep.
[triggers]
crons = ["*/5 * * * *"]
