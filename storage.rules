rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function owns(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function allowedMedia() {
      // Declared MIME is a first gate. Byte sniffing and malware scanning are
      // required on the backend before any public sharing.
      return request.resource.contentType in [
        'image/jpeg', 'image/png', 'image/webp', 'image/gif', 'image/avif',
        'image/heic', 'image/heif', 'video/mp4', 'video/webm', 'video/quicktime',
        'audio/mpeg', 'audio/mp4', 'audio/wav', 'audio/x-wav', 'audio/ogg',
        'audio/webm', 'audio/flac', 'application/pdf', 'text/plain'
      ];
    }

    // Firebase download-token URLs are bearer access outside these SDK rules.
    // Do not use them for files requiring a UID check on every download.
    match /users/{uid}/{allPaths=**} {
      allow read: if owns(uid);
      allow create, update: if owns(uid)
        && request.resource.size > 0 && request.resource.size <= 100 * 1024 * 1024
        && allowedMedia()
        && request.resource.metadata.keys().hasOnly(['ownerId'])
        && request.resource.metadata.get('ownerId', uid) == uid;
      allow delete: if owns(uid);
    }

    // Evidence is backend-only, including clients with an admin custom claim.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
