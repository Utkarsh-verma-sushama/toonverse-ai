{
  "appId": "ai.toonverse.app",
  "appName": "ToonVerse AI",
  "webDir": "dist",
  "backgroundColor": "#0b1020",
  "server": {
    "androidScheme": "https"
  },
  "android": {
    "allowMixedContent": false,
    "captureInput": true,
    "webContentsDebuggingEnabled": false
  },
  "ios": {
    "contentInset": "automatic",
    "scrollEnabled": true,
    "preferredContentMode": "mobile"
  },
  "plugins": {
    "StatusBar": {
      "overlaysWebView": false,
      "style": "DARK",
      "backgroundColor": "#0b1020"
    }
  }
}
